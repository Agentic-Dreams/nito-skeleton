import { Test, TestingModule } from '@nestjs/testing';
import { NotFoundException } from '@nestjs/common';
import { {{pascalCase name}}Service } from './{{kebabCase name}}.service';
import { {{camelCase name}} } from '../database/schema';
import { RlsService } from '../database/rls.service';

describe('{{pascalCase name}}Service', () => {
  let service: {{pascalCase name}}Service;

  const mockAdmin = { userId: 'admin-uuid', email: 'admin@test.com', role: 'ADMIN' };

  const mockParsedQuery = {
    filters:       {},
    pagination:    { page: 1, limit: 10, skip: 0, take: 10 },
    sort:          { sortBy: 'createdAt', sortOrder: 'desc' as const },
    originalQuery: {},
  };

  /** Factory that creates a chainable Drizzle mock resolving to `resolveValue` */
  const createQueryMock = (resolveValue?: any) => {
    const mock: any = {
      from:      jest.fn().mockReturnThis(),
      where:     jest.fn().mockReturnThis(),
      limit:     jest.fn().mockReturnThis(),
      offset:    jest.fn().mockReturnThis(),
      returning: jest.fn().mockReturnThis(),
      set:       jest.fn().mockReturnThis(),
      values:    jest.fn().mockReturnThis(),
      orderBy:   jest.fn().mockReturnThis(),
      then: (onFulfilled: any) =>
        Promise.resolve(mock.resolveValue).then(onFulfilled),
      resolveValue,
    };
    return mock;
  };

  let mockDb: any;
  let mockRlsService: any;

  beforeEach(async () => {
    mockDb = {
      insert:  jest.fn().mockReturnValue(createQueryMock()),
      select:  jest.fn().mockReturnValue(createQueryMock()),
      update:  jest.fn().mockReturnValue(createQueryMock()),
      delete:  jest.fn().mockReturnValue(createQueryMock()),
      execute: jest.fn().mockResolvedValue(undefined),
    };

    // RlsService.execute invokes the callback directly with mockDb
    mockRlsService = {
      execute: jest.fn((user, callback) => callback(mockDb, user)),
    };

    const module: TestingModule = await Test.createTestingModule({
      providers: [
        {{pascalCase name}}Service,
        { provide: 'DRIZZLE',   useValue: mockDb },
        { provide: RlsService, useValue: mockRlsService },
      ],
    }).compile();

    service = module.get<{{pascalCase name}}Service>({{pascalCase name}}Service);
  });

  afterEach(() => jest.clearAllMocks());

  // ─── create ──────────────────────────────────────────────────────────────

  describe('create', () => {
    it('should create a record and return it', async () => {
      const dto    = { /* fill with valid DTO fields */ } as any;
      const record = { id: 'new-uuid', ...dto };
      mockDb.insert.mockReturnValue(createQueryMock([record]));

      const result = await service.create(dto, mockAdmin);

      expect(result).toEqual(record);
      expect(mockDb.insert).toHaveBeenCalledWith({{camelCase name}});
    });

    it('should use provided transaction when supplied', async () => {
      const dto = { /* fill with valid DTO fields */ } as any;
      const tx  = {
        insert: jest.fn().mockReturnValue({
          values: jest.fn().mockReturnValue({
            returning: jest.fn().mockResolvedValue([{ id: 'tx-uuid', ...dto }]),
          }),
        }),
      };

      await service.create(dto, mockAdmin, tx);

      expect(tx.insert).toHaveBeenCalled();
      expect(mockDb.insert).not.toHaveBeenCalled();
    });
  });

  // ─── findAll ─────────────────────────────────────────────────────────────

  describe('findAll', () => {
    it('should return a paginated response', async () => {
      const records = [{ id: 'uuid-1' }, { id: 'uuid-2' }];
      mockDb.select
        .mockReturnValueOnce(createQueryMock(records))
        .mockReturnValueOnce(createQueryMock([{ count: 2 }]));

      const result = await service.findAll(mockParsedQuery, mockAdmin);

      expect(result.data).toEqual(records);
      expect(result.meta.total).toBe(2);
      expect(mockRlsService.execute).toHaveBeenCalledWith(mockAdmin, expect.any(Function));
    });
  });

  // ─── findOne ─────────────────────────────────────────────────────────────

  describe('findOne', () => {
    it('should return a record by id', async () => {
      const record = { id: 'uuid-1' };
      mockDb.select.mockReturnValue(createQueryMock([record]));

      const result = await service.findOne('uuid-1', mockAdmin);

      expect(result).toEqual(record);
    });

    it('should throw NotFoundException when not found', async () => {
      mockDb.select.mockReturnValue(createQueryMock([]));

      await expect(service.findOne('non-existent', mockAdmin)).rejects.toThrow(NotFoundException);
    });
  });

  // ─── update ──────────────────────────────────────────────────────────────

  describe('update', () => {
    it('should update and return the record', async () => {
      const updated = { id: 'uuid-1', updatedAt: new Date() };
      mockDb.update.mockReturnValue(createQueryMock([updated]));

      const result = await service.update('uuid-1', {} as any, mockAdmin);

      expect(result).toEqual(updated);
    });

    it('should throw NotFoundException when record does not exist', async () => {
      mockDb.update.mockReturnValue(createQueryMock([]));

      await expect(service.update('non-existent', {} as any, mockAdmin)).rejects.toThrow(NotFoundException);
    });
  });

  // ─── remove ──────────────────────────────────────────────────────────────

  describe('remove', () => {
    it('should delete and return the record', async () => {
      const record  = { id: 'uuid-1' };
      const deleted = { id: 'uuid-1' };
      mockDb.select.mockReturnValueOnce(createQueryMock([record]));
      mockDb.delete.mockReturnValue(createQueryMock([deleted]));

      const result = await service.remove('uuid-1', mockAdmin);

      expect(result).toEqual(deleted);
    });

    it('should throw NotFoundException when record does not exist', async () => {
      mockDb.select.mockReturnValue(createQueryMock([]));

      await expect(service.remove('non-existent', mockAdmin)).rejects.toThrow(NotFoundException);
    });
  });
});
